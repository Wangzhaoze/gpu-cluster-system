COMPOSE_PROJECT_NAME=gpu-lab-poc
APP_ENV=development
PORTAL_PORT=8080
POSTGRES_DB=gpu_lab
POSTGRES_USER=gpu_lab
POSTGRES_PASSWORD=GENERATE_WITH_BOOTSTRAP
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=GENERATE_WITH_BOOTSTRAP
SESSION_SECRET=GENERATE_WITH_BOOTSTRAP
SESSION_SECURE_COOKIE=false
SCHEDULER_BACKEND=mock-docker
MOCK_GPU_COUNT=5
LOCAL_GPU_COUNT=1
LAB_BASE_IMAGE=lab-base-dev:2026.10-poc
LAB_SHM_SIZE=2g
LAB_HOST_ROOT=SET_WITH_BOOTSTRAP
DATASET_HOST_PATH=SET_WITH_BOOTSTRAP
LOCAL_CUDA_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu22.04
LOCAL_NODE_IMAGE=node:20.20.2-bookworm-slim
PYTORCH_SOURCE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel
LAB_TORCH_IMAGE=lab-torch-dev:2.7.1-cu128
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
LAB_HOST_EDITOR_ENABLED=false
LAB_HOST_EDITOR_USER=local
LAB_HOST_EDITOR_HOME=/home/local
LAB_HOST_EDITOR_UID=1000
LAB_HOST_EDITOR_GID=1000
LAB_HOST_EDITOR_PYTHON=/usr/bin/python3
